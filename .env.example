# Copy to .env.local and fill in. Never commit .env.local.

# Google Apps Script web-app URL (ends in /exec).
# Deploy scripts/google-apps-script.gs from the target Sheet:
#   Extensions > Apps Script > paste > run setupSheets > Deploy > Web app
#   Execute as: Me      Who has access: Anyone
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxxLJxwqrwj4GIYNb2Ijz3JqysvcviO9CXFAezqHf7ljZf6liXM_NOENepC1H67bnkZ/exec

# TeleCRM lead-ingest endpoint for this enterprise, e.g.
# https://api.telecrm.in/enterprise/<enterpriseId>/autoupdatelead
TELECRM_API_URL=

# TeleCRM API key. Sent as: Authorization: Bearer <key>
TELECRM_API_KEY=
